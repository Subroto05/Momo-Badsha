<%- include('partials/header', { title: 'Menu' }) %>

<article class="main__article">
    <h2>Our Menu</h2>

    <% if (menuItems.length > 0) { %>
        <section class="menu__container">
            <div class="menu__header">Item</div>
            <div class="menu__header">Description</div>
            <div class="menu__header">Price</div>
        
            <% menuItems.forEach(item => { %>
                <div class="menu__column"><%= item.item %></div>
                <div class="menu__column"><%= item.description %></div>
                <div class="menu__column">$<%= item.price %></div>
            <% }); %>
        </section>
        
    <% } else { %>
        <p>No menu items available.</p>
    <% } %>
</article>

<%- include('partials/footer') %>
